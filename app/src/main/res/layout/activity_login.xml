<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12151B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- TÍTULO DO APP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="BL4CK SYSTEM"
            android:textColor="#F3F4F6"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="36dp"
            android:text="Conexão do Gateway Android"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <!-- CARTÃO DE EMPARELHAMENTO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1B2028"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ativar Dispositivo"
                    android:textColor="#F3F4F6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:text="Insira o código de 6 dígitos gerado pelo seu Bot no WhatsApp."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <!-- CAMPO DO CÓDIGO DE EMPARELHAMENTO -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:textColorHint="#9CA3AF"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="#10B981"
                    app:hintTextColor="#10B981">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCodigoEmparelhamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:hint="Ex: BK-8921"
                        android:inputType="textCapCharacters"
                        android:maxLength="7"
                        android:textColor="#F3F4F6"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- BOTÃO CONECTAR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmparelhar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#10B981"
                    android:text="Conectar Dispositivo"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Envie .conectar no WhatsApp para receber o código"
            android:textColor="#6B7280"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
